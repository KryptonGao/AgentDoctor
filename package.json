{
  "name": "@gaochenkai/agentdoctor",
  "version": "0.2.0",
  "description": "DevTools and efficiency diagnostics for AI Coding Agents",
  "type": "module",
  "bin": {
    "agentdoctor": "bin/agentdoctor.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "build:action": "tsup --config tsup.action.config.ts",
    "benchmark": "tsx benchmarks/run.ts",
    "dev": "tsx src/cli/index.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build && npm run build:action"
  },
  "files": [
    "bin",
    "dist",
    "web",
    "action.yml",
    "action-dist",
    "assets/readme",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "agent",
    "devtools",
    "efficiency",
    "claude-code",
    "codex",
    "cursor",
    "tui",
    "linter"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "diff": "^5.2.0",
    "fast-glob": "^3.3.2",
    "ink": "^5.0.1",
    "picocolors": "^1.1.1",
    "react": "^18.3.1",
    "yaml": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/diff": "^5.2.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "tsup": "^8.0.2",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
